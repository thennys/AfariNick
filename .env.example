# I read these from the environment in config/settings.py. Copy this file to `.env`
# and export the values (or set them in your shell) only if you need to change the
# defaults. With none of these set, the project runs on SQLite out of the box.

# --- Core ---
# DJANGO_SECRET_KEY=replace-with-a-long-random-string
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (optional) ---
# Set POSTGRES_DB to switch the app from SQLite to PostgreSQL. If you do, also
# uncomment psycopg2-binary in requirements.txt and install it.
# POSTGRES_DB=afarinick
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
